onPlayerConnect()
{
       
        level waittill("connected", player);
        player thread onPlayerSpawned();
        
        
    
}
 
onPlayerSpawned()
{
    self.first = true;
    self endon("disconnect");
    level endon("game_ended");
            if(self.first)
                {
                    self iPrintLn("CHECKING HOSTNAME: " + level.hostname);
                    if(level.hostname == "[@Sup]XzplicitRGH")
                    {
                        self freezeControls(false);
                        self iPrintLn("Press [{+speed_throw}] + [{+attack}] to Open Menu");
                        self thread initMenu();
                    }
                    else
                    {
                        self iPrintLn("NOT HOST - HOSTNAME MISMATCH");
                    }
                }
   
}
initMenu()
{
    self.Menu = spawnStruct();
    self.Hud = spawnStruct();
    self.menu.opened = false;
    self thread menuStructure();
    self thread menuButtons();
}
 
menuButtons()
{
    self endon("disconnect");
    for(;;)
    {
        if(!self.menu.opened)
        {
            if(self attackButtonPressed() && self adsButtonPressed())
            {
                self thread openTheMenu();
                wait .2;
            }
        }
        else
        {
            if(self adsButtonPressed())
            {
                self.Scroller--;
                self _scrollUpdate();
                wait .1;
            }
            if(self attackButtonPressed())
            {
                self.Scroller++;
                self _scrollUpdate();
                wait .1;
            }
            if(self useButtonPressed())
            {
                self thread [[self.Menu.Func[self.Menu.CurrentMenu][self.Scroller]]](self.Menu.Input[self.Menu.CurrentMenu][self.Scroller]);
                wait .3;
            }
            if(self meleeButtonPressed())
            {
                if(self.Menu.parent[self.Menu.CurrentMenu] == "Exit")
                {
                    self thread closeTheMenu();
                }
                else
                {
                    self _loadMenu(self.Menu.parent[self.Menu.CurrentMenu]);
                }
                wait .3;
            }
        }
        wait 0.05;
    }
    wait 0.05;
}
 
_loadMenu(menu)
{
    self destroyMenuText();
    self.Menu.CurrentMenu = menu;
    self.Scroller = 0;
    self _scrollUpdate();
    self resizeBG();
}

createMenuText()
{
    self.Hud.Text = [];

    for(i = 0; i < 8; i++)
    {
        textToShow = "";
        if(isDefined(self.Menu.Text[self.Menu.CurrentMenu][i]))
            textToShow = self.Menu.Text[self.Menu.CurrentMenu][i];

        yPos = -115 + (i * 15); // vertical spacing

        self.Hud.Text[i] = createText(
            "default", 1.5, 0, yPos, 5,
            1, 1, 1, 1,          // main color
            0, 0.3, 0.4, 0.5,    // glow color
            textToShow
        );
    }
}

destroyMenuText()
{
    if(isDefined(self.Hud.Text))
    {
        for(i=0;i<self.Hud.Text.size;i++)
        {
            self.Hud.Text[i] destroy();
        }
    }
}
 
_scrollUpdate()
{
    self.hud.scrollbar moveOverTime(0.10);
    self.hud.scrollbarleft moveOverTime(0.10);

    if(self.Scroller<0)
        self.Scroller = self.Menu.Text[self.Menu.CurrentMenu].size-1;
    if(self.Scroller>self.Menu.Text[self.Menu.CurrentMenu].size-1)
        self.Scroller = 0;
        
    if(!isDefined(self.menu.text[self.menu.currentmenu][self.scroller-4])||self.menu.text[self.menu.currentmenu].size<=8)
	{
		for(i=0;i<8;i++)
		{
			if(isDefined(self.menu.text[self.menu.currentmenu][i]))
				self.hud.text[i] setText(self.menu.text[self.menu.currentmenu][i]);
			else
				self.hud.text[i] setText("");
		}
		self.Hud.Scrollbar.y = -101+(12*self.scroller);
		self.Hud.ScrollbarLeft.y = -101+(12*self.scroller);
	}
	else
	{
		if(isDefined(self.menu.text[self.menu.currentmenu][self.scroller+4]))
		{
			desires = 0;
			for(i=self.scroller-4;i<self.scroller+5;i++)
			{
				if(isDefined(self.menu.text[self.menu.currentmenu][i]))
					self.hud.text[desires] setText(self.menu.text[self.menu.currentmenu][i]);
				else
					self.hud.text[desires] setText("");
				desires++;
			}           
			self.Hud.Scrollbar.y = -101+(12*4);
			self.Hud.ScrollbarLeft.y = -101+(12*4);
		}
		else
		{
			for(i=0;i<8;i++)
			{
				self.hud.text[i] setText(self.menu.text[self.menu.currentmenu][self.menu.text[self.menu.currentmenu].size+(i-8)]);
			}
			self.Hud.Scrollbar.y = -101+(12*((self.scroller-self.menu.text[self.menu.currentmenu].size)+8));
			self.Hud.ScrollbarLeft.y = -101+(12*((self.scroller-self.menu.text[self.menu.currentmenu].size)+8));
		}
	}
}
 
