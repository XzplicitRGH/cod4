scrollbarPulse()
{
    self endon("death");
    
    while(isDefined(self))
    {
        self fadeOverTime(0.4);
        self.alpha = 0.6;
        wait 0.4;
        
        self fadeOverTime(0.4);
        self.alpha = 0.9;
        wait 0.4;
    }
}


