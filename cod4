destroyMenu()
{
    if(isDefined(self.menuBackground))
        self.menuBackground destroy();
    if(isDefined(self.menuGlowTop))
        self.menuGlowTop destroy();
    if(isDefined(self.menuGlowBottom))
        self.menuGlowBottom destroy();
    if(isDefined(self.menuGlowLeft))
        self.menuGlowLeft destroy();
    if(isDefined(self.menuGlowRight))
        self.menuGlowRight destroy();
    if(isDefined(self.menuHeaderBG))
        self.menuHeaderBG destroy();
    if(isDefined(self.menuHeaderAccent))
        self.menuHeaderAccent destroy();
    if(isDefined(self.menuHeaderText))
        self.menuHeaderText destroy();
    if(isDefined(self.menuLevelText))
        self.menuLevelText destroy();
    if(isDefined(self.menuDivider))
        self.menuDivider destroy();
    if(isDefined(self.menuScroller))
        self.menuScroller destroy();
    if(isDefined(self.menuScrollCounter))
        self.menuScrollCounter destroy();
    if(isDefined(self.menuFooterLine))
        self.menuFooterLine destroy();
    if(isDefined(self.menuFooterText))
        self.menuFooterText destroy();
    
    if(isDefined(self.menuOptions))
    {
        for(i = 0; i < self.menuOptions.size; i++)
        {
            if(isDefined(self.menuOptions[i]))
                self.menuOptions[i] destroy();
        }
    }
}


createRightShader(x, y, width, height, color, sort, alpha)
{
    hud = newClientHudElem(self);
    hud.color = color;
    hud.alpha = alpha;
    hud.sort = sort;
    hud.x = x;
    hud.y = y;
    hud.alignX = "right";
    hud.alignY = "middle";
    hud.horzAlign = "right";
    hud.vertAlign = "middle";
    hud setShader("white", width, height);
    return hud;
}


createRightText(fontScale, x, y, sort, color, text)
{
    hud = newClientHudElem(self);
    hud.font = "objective";
    hud.fontScale = fontScale;
    hud.sort = sort;
    hud.color = color;
    hud.alpha = 1.5;
    hud.x = x;
    hud.y = y;
    hud.alignX = "left";
    hud.alignY = "middle";
    hud.horzAlign = "right";
    hud.vertAlign = "middle";
    hud setText(text);
    return hud;
}


