init()
{
    level thread onPlayerConnect();
}

onPlayerConnect()
{
    for(;;)
    {
        level waittill("connected", player);
        player thread onPlayerSpawned();
    }
}

onPlayerSpawned()
{
    self endon("disconnect");
    
    for(;;)
    {
        self waittill("spawned_player");
        self freezeControls(false);
		
		self iprintln(RED + BUILD);
		self iprintlnbold(WELCOME_MSG);
        self thread initMenu();
    }
}

initMenu()
{
    self.menuOpen = false;
    self.menuScroll = 0;
    self.currentMenu = "main";
    self.menuLevel = 0;
    
    self thread menuMonitor();
    self thread menuDeathMonitor();
}

menuDeathMonitor()
{
    self endon("disconnect");
    
    for(;;)
    {
        self waittill("death");
        
        if(self.menuOpen)
        {
            self.menuOpen = false;
            self notify("menuClosed");
            self thread destroyMenu();
        }
    }
}

menuMonitor()
{
    self endon("death");
    self endon("disconnect");
    
    for(;;)
    {
        if(self meleeButtonPressed() && self adsButtonPressed())
        {
            if(!self.menuOpen)
            {
                self.menuOpen = true;
                self.currentMenu = "main";
                self.menuLevel = 0;
                self thread drawMenu();
                self thread menuScroll();
            }
            else
            {
                self.menuOpen = false;
                self notify("menuClosed");
                self thread destroyMenu();
            }
            wait 0.3;
        }
        wait 0.05;
    }
}

menuScroll()
{
    self endon("death");
    self endon("disconnect");
    self endon("menuClosed");
    
    for(;;)
    {
        if(self attackButtonPressed())
        {
            self.menuScroll++;
            if(self.menuScroll > self.menuMaxScroll)
                self.menuScroll = 0;
            
            self thread updateScroller();
            wait 0.15;
        }
        else if(self adsButtonPressed())
        {
            self.menuScroll--;
            if(self.menuScroll < 0)
                self.menuScroll = self.menuMaxScroll;
            
            self thread updateScroller();
            wait 0.15;
        }
        else if(self useButtonPressed())
        {
            self thread selectOption();
            wait 0.3;
        }
        else if(self meleeButtonPressed() && self.menuLevel > 0)
        {
            self thread goBackMenu();
            wait 0.3;
        }
        
        wait 0.05;
    }
}

selectOption()
{
    menuName = self.currentMenu;
    option = self.menuScroll;
    
    if(menuName == "main")
    {
        if(option == 0)
            self thread loadSubmenu("aimbot");
        else if(option == 1)
            self thread loadSubmenu("fun");
        else if(option == 2)
            self thread loadSubmenu("vision");
        else if(option == 3)
            self thread loadSubmenu("gametype");
        else if(option == 4)
            self thread loadSubmenu("killstreak");
        else if(option == 5)
            self thread loadSubmenu("weapon");
        else if(option == 6)
            self thread loadSubmenu("dev");
        else if(option == 7)
            self thread loadSubmenu("allclients");
    }
    else if(menuName == "aimbot")
    {
        if(option == 0)
            self iPrintLn("Aimbot Toggle");
        else if(option == 1)
            self iPrintLn("Auto Aim");
        else if(option == 2)
            self iPrintLn("Aim Assist");
    }
    else if(menuName == "fun")
    {
        if(option == 0)
            self iPrintLn("UFO Mode");
        else if(option == 1)
            self iPrintLn("Speed Boost");
        else if(option == 2)
            self iPrintLn("Super Jump");
    }
     else if(menuName == "dev")
    {
        if(option == 0)
            self  iPrintLn("TEST");
    }
}

loadSubmenu(submenu)
{
    self.currentMenu = submenu;
    self.menuLevel++;
    self.menuScroll = 0;
    
    self thread destroyMenu();
    wait 0.05;
    self thread drawMenu();
}

goBackMenu()
{
    self.currentMenu = "main";
    self.menuLevel = 0;
    self.menuScroll = 0;
    
    self thread destroyMenu();
    wait 0.05;
    self thread drawMenu();
}

updateScroller()
{
    for(i = 0; i < self.menuOptions.size; i++)
    {
        if(i == self.menuScroll)
            self.menuOptions[i].color = (0, 1, 1);
        else
            self.menuOptions[i].color = (0.9, 0.9, 0.9);
    }
    
    yPos = -80 + (self.menuScroll * 25);
    self.menuScroller moveOverTime(0.1);
    self.menuScroller.y = yPos;
    
    if(isDefined(self.menuScrollCounter))
        self.menuScrollCounter setText((self.menuScroll + 1) + "/" + (self.menuMaxScroll + 1));
}

drawMenu()
{
    
    self.menuBackground = self createRightShader(-50, 0, 140, 300, (0.08, 0.08, 0.12), 1, 0.85);
    
    
    self.menuGlowTop = self createRightShader(-50, -150, 140, 2, (0, 0.8, 1), 3, 0.9);
    self.menuGlowBottom = self createRightShader(-50, 150, 140, 2, (0, 0.8, 1), 3, 0.9);
    self.menuGlowLeft = self createRightShader(-190, 0, 2, 300, (0, 0.8, 1), 3, 0.9);
    self.menuGlowRight = self createRightShader(-50, 0, 2, 300, (0, 0.8, 1), 3, 0.9);
    
   
    self.menuHeaderBG = self createRightShader(-50, -128, 140, 45, (0.05, 0.15, 0.25), 2, 0.95);
    self.menuHeaderAccent = self createRightShader(-50, -105, 140, 3, (0, 0.6, 0.9), 3, 1);
    
  
    headerText = self getMenuTitle();
    self.menuHeaderText = self createRightText(1.6, -160, -125, 4, (0, 1, 1), headerText);

    
   
    self.menuDivider = self createRightShader(-50, -90, 140, 1, (0, 0.6, 0.9), 2, 0.5);
    
    
    self.menuOptions = [];
    self thread loadMenuOptions();
    
    
    self.menuScroller = self createRightShader(-50, -80, 140, 22, (0, 0.5, 0.8), 2, 0.3);
    
  
    self.menuScrollCounter = self createRightText(1.0, -65, 125, 3, (0, 0.8, 1), "1/" + (self.menuMaxScroll + 1));
    
   
    self.menuFooterLine = self createRightShader(-50, 140, 140, 1, (0, 0.6, 0.9), 2, 0.5);
    //self.menuFooterText = self createRightText(1.4, -180, 145, 1, (0.5, 0.5, 0.5), "USE: Select | MELEE: Back");
}

