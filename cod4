resizeBG()
{
    size = self.Menu.Text[self.Menu.CurrentMenu].size;
    if(size > 8)
        size = 8;
    
  
    bgHeight = (12 * size) + 2;
    bgCenterY = -107 + (bgHeight / 2);
    
    self.hud.background setShader("white", 180, bgHeight);
    self.hud.background.y = bgCenterY;
    
    
    bottomY = -107 + bgHeight;
    self.hud.bottombar.y = bottomY;
    self.hud.bottombar2.y = bottomY - 1;
}
destroyHud()
{
    self.Hud.Background destroy();
    self.hud.titlebackground destroy();
    self.Hud.Scrollbar destroy();
    self.Hud.ScrollbarLeft destroy();
    self.hud.topbar destroy();
    self.hud.topbar2 destroy();
    self.hud.bottombar destroy();
    self.hud.bottombar2 destroy();
    self.hud.menutitle destroy();
    self.hud.corner1 destroy();
    self.hud.corner2 destroy();
}
